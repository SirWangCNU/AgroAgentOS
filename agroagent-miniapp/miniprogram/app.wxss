/* app.wxss 全局样式 —— 对应设计稿 :root 设计变量 */
page {
  --brand: #16a34a;
  --brand-light: #22c55e;
  --brand-dark: #15803d;
  --amber: #f59e0b;
  --red: #ef4444;
  --blue: #3b82f6;
  --purple: #8b5cf6;
  --bg: #f8fafc;
  --surface: #ffffff;
  --text: #0f172a;
  --text-sec: #64748b;
  --text-ter: #94a3b8;
  --border: #e2e8f0;
  --r-xl: 32rpx;
  --r-lg: 24rpx;
  --r-md: 16rpx;
  --sh-sm: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  --sh-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --sh-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view { box-sizing: border-box; }

/* 通用：页面容器（状态栏+导航已用自定义，这里统一留白） */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* 通用：卡片 */
.card {
  background: var(--surface);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-sm);
}

/* 通用：文本省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
