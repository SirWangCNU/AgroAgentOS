<view class="msg {{role === 'user' ? 'u' : 'ai'}}">
  <view wx:if="{{role === 'ai'}}" class="avatar">
    <text class="avatar-t">🌱</text>
  </view>
  <view class="bubble">
    <!-- 思考中：三点动画 + 当前进度阶段 -->
    <block wx:if="{{thinking}}">
      <view class="typing">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
      <view wx:if="{{progress}}" class="progress-line">{{progress}}</view>
    </block>
    <!-- 正常内容 -->
    <view wx:else class="text">{{content}}</view>
    <!-- 引用来源 -->
    <view wx:if="{{role === 'ai' && sources.length}}" class="src">
      <text>参考了 {{sources.length}} 篇农业文献</text>
    </view>
  </view>
</view>
