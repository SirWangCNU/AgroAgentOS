.page { padding: 40rpx; background: var(--bg); min-height: 100vh; }
.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.city { font-size: 40rpx; font-weight: 700; color: var(--text); }
.refresh { font-size: 44rpx; color: var(--brand); }

.now { padding: 48rpx; text-align: center; margin-bottom: 32rpx; }
.temp { font-size: 96rpx; font-weight: 700; color: var(--text); line-height: 1; }
.cond { font-size: 30rpx; color: var(--text-sec); margin: 16rpx 0 24rpx; }
.meta { display: flex; justify-content: center; gap: 40rpx; font-size: 24rpx; color: var(--text-ter); }

.advice { padding: 32rpx; }
.a-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 16rpx; }
.a-text { font-size: 28rpx; color: var(--text); line-height: 1.6; }
