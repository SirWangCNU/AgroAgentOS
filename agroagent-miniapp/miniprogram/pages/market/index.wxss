.page { padding: 32rpx; background: var(--bg); min-height: 100vh; }
.tabs { white-space: nowrap; margin-bottom: 32rpx; }
.tab {
  display: inline-block; padding: 12rpx 36rpx; margin-right: 16rpx;
  background: var(--surface); border-radius: 40rpx; font-size: 26rpx;
  color: var(--text-sec); box-shadow: var(--sh-sm);
}
.tab.active { background: var(--brand); color: #fff; }

.box { padding: 32rpx; }
.bt { font-size: 32rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.bsub { font-size: 26rpx; color: var(--text-sec); line-height: 1.6; margin-bottom: 24rpx; }

.price { display: flex; flex-direction: column; gap: 16rpx; }
.price-row {
  display: flex; justify-content: space-between; align-items: center;
  background: #f8fafc; border-radius: var(--r-lg); padding: 24rpx 28rpx;
}
.pname { font-size: 28rpx; color: var(--text); font-weight: 500; }
.pval { font-size: 30rpx; color: var(--brand-dark); font-weight: 700; }

.empty { text-align: center; color: var(--text-ter); padding: 80rpx 0; font-size: 28rpx; }
