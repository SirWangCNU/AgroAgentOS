<view class="page">
  <scroll-view class="tabs" scroll-x>
    <view
      class="tab {{crop === item ? 'active' : ''}}"
      wx:for="{{crops}}"
      wx:key="*this"
      data-crop="{{item}}"
      bindtap="onCrop"
    >{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">行情加载中...</view>

  <view wx:elif="{{overview}}" class="card box">
    <view class="bt">📈 {{crop}} 综合行情</view>
    <view class="bsub">{{overview.summary || '暂无综合分析'}}</view>

    <view wx:if="{{overview.prices}}" class="price">
      <view class="price-row" wx:for="{{overview.prices}}" wx:key="name">
        <text class="pname">{{item.name}}</text>
        <text class="pval">{{item.price}}{{item.unit}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">暂无行情数据，请稍后重试</view>
</view>
