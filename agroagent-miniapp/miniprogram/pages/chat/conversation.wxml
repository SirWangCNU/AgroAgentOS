<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px"></view>

  <view class="header">
    <view class="back" bindtap="onBack">‹</view>
    <view class="header-title">智农助手</view>
    <view class="header-icons">
      <text class="h-icon">⋯</text>
    </view>
  </view>

  <scroll-view class="ca" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <view class="inner">
      <chat-bubble
        wx:for="{{messages}}"
        wx:key="index"
        role="{{item.role}}"
        content="{{item.content}}"
        thinking="{{item.thinking}}"
        sources="{{item.sources}}"
        progress="{{item.progress}}"
      />
      <view style="height: 24rpx"></view>
    </view>
  </scroll-view>

  <!-- 功能标签 -->
  <view class="tpls">
    <view class="tpl">🌐 联网搜索已开启</view>
    <view class="tpl">📚 知识库检索</view>
  </view>

  <view class="ib">
    <view class="ic">
      <input
        class="ip"
        placeholder="输入你的问题..."
        placeholder-class="ip-ph"
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
      />
      <view class="ia">📷</view>
      <view class="ia">🎤</view>
      <view class="send-btn" bindtap="onSend">↑</view>
    </view>
  </view>
</view>
