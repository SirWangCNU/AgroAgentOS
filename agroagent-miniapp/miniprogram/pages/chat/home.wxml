<view class="page">
  <!-- 自定义状态栏 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px"></view>

  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-title">智农助手</view>
    <view class="header-icons">
      <text class="h-icon">⋯</text>
    </view>
  </view>

  <scroll-view class="ca" scroll-y>
    <!-- 问候区 -->
    <view class="hello">
      <view class="avatar">🌱</view>
      <view class="gt">你好，我是智农助手</view>
      <view class="gs">你的智能农业伙伴</view>
    </view>

    <!-- 快捷入口 -->
    <view class="qa">
      <view
        wx:for="{{quickActions}}"
        wx:key="id"
        class="qc"
        data-id="{{item.id}}"
        bindtap="onQuick"
        hover-class="qc-hover"
      >
        <view class="qi" style="background: {{item.color}}">
          <text class="qi-emoji">{{item.icon}}</text>
        </view>
        <view class="qct">{{item.title}}<br/>{{item.sub}}</view>
      </view>
    </view>

    <!-- 猜你想问 -->
    <view class="sug">
      <view class="sug-t">猜你想问</view>
      <view class="chr">
        <view
          wx:for="{{suggests}}"
          wx:key="*this"
          class="ch"
          data-q="{{item}}"
          bindtap="onSuggest"
        >{{item}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="ib">
    <view class="ic">
      <input
        class="ip"
        placeholder="输入你的问题..."
        placeholder-class="ip-ph"
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
      />
      <view class="ia">📷</view>
      <view class="ia">🎤</view>
      <view class="send-btn" bindtap="onSend">↑</view>
    </view>
  </view>
</view>
