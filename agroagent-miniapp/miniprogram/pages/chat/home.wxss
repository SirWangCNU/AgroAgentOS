.status-bar { width: 100%; background: var(--bg); }

.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 40rpx 24rpx; flex-shrink: 0;
}
.header-title { font-size: 34rpx; font-weight: 600; color: var(--text); }
.header-icons .h-icon { font-size: 44rpx; color: var(--text); line-height: 1; }

.ca { flex: 1; overflow-y: auto; }

.hello {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 40rpx 32rpx; text-align: center;
}
.avatar {
  width: 144rpx; height: 144rpx; border-radius: 50%;
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
  display: flex; align-items: center; justify-content: center;
  font-size: 72rpx; margin-bottom: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(22, 163, 74, 0.15);
}
.gt { font-size: 44rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.gs { font-size: 28rpx; color: var(--text-sec); }

.qa {
  display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx;
  padding: 32rpx 40rpx 16rpx;
}
.qc {
  background: var(--surface); border-radius: var(--r-xl);
  padding: 32rpx; display: flex; align-items: center; gap: 24rpx;
  box-shadow: var(--sh-sm);
}
.qc-hover { transform: scale(0.97); }
.qi {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.qi-emoji { font-size: 44rpx; }
.qct { font-size: 26rpx; font-weight: 600; color: var(--text); line-height: 1.4; }

.sug { padding: 32rpx 40rpx; }
.sug-t { font-size: 26rpx; color: var(--text-ter); margin-bottom: 20rpx; font-weight: 500; }
.chr { display: flex; flex-direction: column; gap: 16rpx; }
.ch {
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: var(--r-xl); padding: 20rpx 32rpx; font-size: 26rpx;
  color: var(--text); display: flex; align-items: center; gap: 16rpx;
}
.ch::before { content: ''; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--brand); flex-shrink: 0; }

.ib { padding: 16rpx 32rpx 48rpx; flex-shrink: 0; }
.ic {
  display: flex; align-items: center; gap: 16rpx;
  background: var(--surface); border-radius: 48rpx; padding: 16rpx 16rpx 16rpx 32rpx;
  box-shadow: var(--sh-md); border: 1rpx solid var(--border);
}
.ip { flex: 1; font-size: 28rpx; color: var(--text-ter); }
.ip-ph { color: var(--text-ter); }
.ia { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.send-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--brand);
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; flex-shrink: 0;
}
.send-btn:active { background: var(--brand-dark); }
