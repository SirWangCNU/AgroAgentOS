<view class="page">
  <view class="top">
    <view class="search">
      <text class="search-ico">🔍</text>
      <text class="search-ph">搜索工具或功能...</text>
    </view>

    <view class="stats">
      <view class="sc" wx:for="{{stats}}" wx:key="label">
        <view class="sv">{{item.value}}</view>
        <view class="sl">{{item.label}}</view>
      </view>
    </view>

    <view class="section">
      <view class="sect">常用工具</view>
      <view class="tg">
        <view
          class="tc"
          wx:for="{{tools}}"
          wx:key="id"
          data-path="{{item.path}}"
          bindtap="onTool"
          hover-class="tc-hover"
        >
          <view class="tch">
            <view class="tci" style="background: {{item.color}}">{{item.icon}}</view>
            <view wx:if="{{item.badge}}" class="tbadge">{{item.badge}}</view>
          </view>
          <view class="tct">{{item.title}}</view>
          <view class="tcp">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="sect">更多功能</view>
      <view class="fl">
        <view
          class="fi"
          wx:for="{{more}}"
          wx:key="id"
          data-path="{{item.path}}"
          bindtap="onMore"
        >
          <view class="fic" style="background: {{item.color}}">{{item.icon}}</view>
          <view class="fit">{{item.title}}</view>
          <view wx:if="{{item.desc}}" class="fn">{{item.desc}}</view>
          <text class="far">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="sect">最近使用</view>
      <scroll-view class="rsc" scroll-x>
        <view class="rc" wx:for="{{recent}}" wx:key="id">
          <view class="rct">{{item.title}}</view>
          <view class="rcb">
            <view class="rcbig">{{item.big}}</view>
            <view class="rcsub">{{item.sub}}</view>
            <view class="rctip" style="color: {{item.tipColor}}">{{item.tip}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view style="height: 40rpx"></view>
  </view>
</view>
