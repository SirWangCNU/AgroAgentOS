.page { background: var(--bg); }
.top { padding: 16rpx 40rpx; }

.search {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: 24rpx; padding: 20rpx 32rpx; margin-bottom: 32rpx;
}
.search-ico { font-size: 32rpx; }
.search-ph { font-size: 28rpx; color: var(--text-ter); }

.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; margin-bottom: 40rpx; }
.sc { background: var(--surface); border-radius: var(--r-lg); padding: 28rpx 24rpx; text-align: center; box-shadow: var(--sh-sm); }
.sv { font-size: 44rpx; font-weight: 700; color: var(--text); margin-bottom: 4rpx; }
.sl { font-size: 22rpx; color: var(--text-sec); font-weight: 500; }

.section { margin-bottom: 40rpx; }
.sect { font-size: 32rpx; font-weight: 700; color: var(--text); margin-bottom: 24rpx; }

.tg { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.tc { background: var(--surface); border-radius: var(--r-xl); padding: 32rpx; box-shadow: var(--sh-sm); }
.tc-hover { transform: scale(0.97); }
.tch { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.tci { width: 76rpx; height: 76rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.tbadge { font-size: 20rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 20rpx; background: #fef3c7; color: #b45309; }
.tct { font-size: 28rpx; font-weight: 600; color: var(--text); margin-bottom: 8rpx; }
.tcp { font-size: 24rpx; color: var(--text-sec); }

.fl { background: var(--surface); border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--sh-sm); }
.fi { display: flex; align-items: center; padding: 28rpx 32rpx; gap: 24rpx; }
.fi + .fi { border-top: 1rpx solid var(--border); }
.fic { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.fit { flex: 1; font-size: 28rpx; font-weight: 500; color: var(--text); }
.fn { font-size: 20rpx; font-weight: 700; color: #fff; background: linear-gradient(135deg, #ef4444, #f97316); padding: 4rpx 12rpx; border-radius: 12rpx; }
.far { color: var(--text-ter); font-size: 36rpx; }

.rsc { display: flex; gap: 24rpx; white-space: nowrap; }
.rc { min-width: 400rpx; background: var(--surface); border-radius: var(--r-xl); padding: 28rpx; box-shadow: var(--sh-sm); display: inline-block; }
.rct { font-size: 26rpx; font-weight: 600; color: var(--text); margin-bottom: 16rpx; }
.rcbig { font-size: 48rpx; font-weight: 700; color: var(--amber); margin-bottom: 8rpx; }
.rcsub { font-size: 24rpx; color: var(--text-sec); line-height: 1.5; }
.rctip { margin-top: 12rpx; font-size: 24rpx; font-weight: 500; }
