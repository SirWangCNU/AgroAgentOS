.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #f8fafc 40%);
  padding: 80rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* ==================== 品牌区 ==================== */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}
.logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #16a34a, #22c55e);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 163, 74, 0.3);
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #94a3b8;
}

/* ==================== 表单 ==================== */
.form {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.field {
  margin-bottom: 32rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #f8fafc;
}
.input:focus {
  border-color: #16a34a;
  background: #fff;
}

.error {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fef2f2;
  border-radius: 12rpx;
  color: #dc2626;
  font-size: 26rpx;
  text-align: center;
}

.btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #16a34a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn-loading {
  opacity: 0.6;
}
.btn[disabled] {
  background: #16a34a;
  color: #fff;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}
