<view class="page">
  <view class="brand">
    <view class="logo">🌾</view>
    <view class="title">智农助手</view>
    <view class="subtitle">智农协同平台</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">用户名</text>
      <input
        class="input"
        type="text"
        placeholder="请输入用户名"
        value="{{username}}"
        bindinput="onUsernameInput"
        confirm-type="next"
      />
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input
        class="input"
        password="{{true}}"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
        confirm-type="go"
        bindconfirm="onLogin"
      />
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <button
      class="btn {{loading ? 'btn-loading' : ''}}"
      bindtap="onLogin"
      disabled="{{loading}}"
    >
      {{loading ? '登录中…' : '登录'}}
    </button>

    <view class="tip">小程序和网页端共用同一账号体系</view>
  </view>
</view>
