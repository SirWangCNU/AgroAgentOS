.page { background: var(--bg); padding-bottom: 60rpx; }

.profile-head {
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 40rpx 48rpx; text-align: center;
}
.pa {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), #22c55e);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(22, 163, 74, 0.25);
}
.pat { font-size: 64rpx; font-weight: 700; color: #fff; }
.pn { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.pr {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: #f0fdf4; border: 1rpx solid #bbf7d0;
  border-radius: 40rpx; padding: 8rpx 28rpx;
  font-size: 24rpx; color: var(--brand); font-weight: 600;
}

.sg {
  margin: 0 40rpx 32rpx; background: var(--surface);
  border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--sh-sm);
}
.si { display: flex; align-items: center; padding: 28rpx 32rpx; gap: 24rpx; }
.si + .si { border-top: 1rpx solid var(--border); }
.sic { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.sc2 { flex: 1; display: flex; align-items: center; justify-content: space-between; }
.st3 { font-size: 30rpx; font-weight: 500; color: var(--text); }
.sv2 { font-size: 26rpx; color: var(--text-ter); margin-right: 8rpx; }
.sa { color: var(--text-ter); font-size: 40rpx; }

.logout {
  margin: 0 40rpx 32rpx; background: var(--surface);
  border-radius: var(--r-xl); padding: 28rpx; text-align: center;
  color: var(--red); font-size: 30rpx; font-weight: 500; box-shadow: var(--sh-sm);
}

.ai2 { text-align: center; padding: 48rpx 40rpx 32rpx; }
.av2 { font-size: 26rpx; color: var(--text-ter); margin-bottom: 8rpx; }
.an { font-size: 24rpx; color: var(--text-ter); opacity: 0.7; }

/* ==================== 账号同步卡片 ==================== */
.bind-card {
  margin: 0 40rpx 32rpx;
  background: var(--surface);
  border-radius: var(--r-xl);
  padding: 32rpx;
  box-shadow: var(--sh-sm);
}
.bind-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.bind-title { font-size: 30rpx; font-weight: 600; color: var(--text); }
.bind-tag {
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx;
  background: #dcfce7; color: #16a34a;
}
.bind-tag-off { background: #fef3c7; color: #b45309; }
.bind-desc { font-size: 26rpx; color: var(--text-ter); line-height: 1.6; margin-bottom: 20rpx; }
.bind-name { color: var(--brand); font-weight: 600; }
.bind-actions { display: flex; gap: 16rpx; }
.bind-btn {
  flex: 1; text-align: center;
  padding: 20rpx; border-radius: 16rpx;
  background: var(--brand); color: #fff;
  font-size: 28rpx; font-weight: 500;
}

/* ==================== 弹窗 ==================== */
.mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.dialog {
  width: 620rpx; background: #fff;
  border-radius: 32rpx; padding: 48rpx 40rpx;
}
.dialog-title { font-size: 34rpx; font-weight: 700; color: var(--text); text-align: center; margin-bottom: 16rpx; }
.dialog-desc { font-size: 26rpx; color: var(--text-ter); line-height: 1.6; margin-bottom: 32rpx; }
.dialog-input {
  width: 100%; box-sizing: border-box;
  border: 2rpx solid var(--border); border-radius: 16rpx;
  padding: 24rpx; font-size: 44rpx; text-align: center;
  letter-spacing: 12rpx; font-family: monospace;
  color: var(--text);
}
.dialog-error {
  margin-top: 16rpx; padding: 16rpx;
  background: #fef2f2; border-radius: 12rpx;
  color: #dc2626; font-size: 24rpx; text-align: center;
}
.dialog-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.dialog-btn {
  flex: 1; text-align: center; padding: 24rpx;
  border-radius: 16rpx; font-size: 30rpx; font-weight: 500;
}
.dialog-btn-cancel { background: #f1f5f9; color: var(--text-sec); }
.dialog-btn-ok { background: var(--brand); color: #fff; }
.dialog-btn-loading { opacity: 0.6; }
