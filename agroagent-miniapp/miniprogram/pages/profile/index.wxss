.page { background: var(--bg); padding-bottom: 60rpx; }
.profile-head { display: flex; flex-direction: column; align-items: center; padding: 40rpx 40rpx 48rpx; text-align: center; }
.pa { width: 160rpx; height: 160rpx; border-radius: 50%; background: linear-gradient(135deg, var(--brand), #22c55e); display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(22, 163, 74, 0.25); }
.pat { font-size: 64rpx; font-weight: 700; color: #fff; }
.pn { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.pr { display: inline-flex; align-items: center; gap: 8rpx; background: #f0fdf4; border: 1rpx solid #bbf7d0; border-radius: 40rpx; padding: 8rpx 28rpx; font-size: 24rpx; color: var(--brand); font-weight: 600; }
.sg { margin: 0 40rpx 32rpx; background: var(--surface); border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--sh-sm); }
.si { display: flex; align-items: center; padding: 28rpx 32rpx; gap: 24rpx; }
.si + .si { border-top: 1rpx solid var(--border); }
.sic { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.sc2 { flex: 1; display: flex; align-items: center; justify-content: space-between; }
.st3 { font-size: 30rpx; font-weight: 500; color: var(--text); }
.sv2 { font-size: 26rpx; color: var(--text-ter); margin-right: 8rpx; }
.sa { color: var(--text-ter); font-size: 40rpx; }
.logout { margin: 0 40rpx 32rpx; background: var(--surface); border-radius: var(--r-xl); padding: 28rpx; text-align: center; color: var(--red); font-size: 30rpx; font-weight: 500; box-shadow: var(--sh-sm); }
.ai2 { text-align: center; padding: 48rpx 40rpx 32rpx; }
.av2 { font-size: 26rpx; color: var(--text-ter); margin-bottom: 8rpx; }
.an { font-size: 24rpx; color: var(--text-ter); opacity: 0.7; }
