.page { padding: 40rpx; background: var(--bg); min-height: 100vh; }
.head { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 32rpx; }

.picker {
  width: 100%; height: 480rpx; border-radius: var(--r-xl);
  background: var(--surface); box-shadow: var(--sh-sm);
  display: flex; align-items: center; justify-content: center; overflow: hidden;
  border: 2rpx dashed var(--border);
}
.preview { width: 100%; height: 100%; }
.ph { display: flex; flex-direction: column; align-items: center; gap: 16rpx; color: var(--text-ter); }
.ph-ico { font-size: 80rpx; }
.ph-t { font-size: 28rpx; }

.btn {
  margin-top: 32rpx; background: var(--brand); color: #fff;
  border-radius: 48rpx; font-size: 30rpx; padding: 20rpx 0;
}
.btn[disabled] { opacity: 0.6; }

.result { margin-top: 32rpx; padding: 32rpx; }
.r-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 16rpx; }
.r-summary { font-size: 28rpx; color: var(--text); line-height: 1.6; }
.r-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.r-item {
  display: flex; justify-content: space-between; align-items: center;
  background: #f0fdf4; border: 1rpx solid #bbf7d0; border-radius: var(--r-lg);
  padding: 20rpx 28rpx;
}
.r-name { font-size: 28rpx; font-weight: 600; color: var(--brand-dark); }
.r-conf { font-size: 24rpx; color: var(--text-sec); }
.r-tip { margin-top: 20rpx; font-size: 24rpx; color: var(--red); }
