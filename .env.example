# ============================================================
# AgroAgentOS 智农协同平台 - 环境配置
# ============================================================

# Application
APP_NAME=AgroAgentOS
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=9800

# LLM / Embedding (DashScope 通义千问)
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-max
DASHSCOPE_ROUTER_MODEL=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIM=1024

# Optional DeepSeek-compatible model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Milvus 向量数据库 (农业知识库专用)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agro_agent_kb
MILVUS_TIMEOUT_MS=10000

# RAG 农业知识库检索
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
KB_ADMIN_TOKEN=change-this-admin-token
RAG_HYBRID_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=gte-rerank-v2

# Redis 会话记忆
REDIS_URL=redis://localhost:6379/0
RAG_CHAT_MEMORY_ENABLED=false
RAG_CHAT_HISTORY_TURNS=3
RAG_CHAT_MEMORY_TTL_SEC=604800

# MCP 工具端点 (农业场景)
MCP_WEATHER_URL=http://localhost:8010/mcp
MCP_WEBSEARCH_URL=http://localhost:8006/mcp

# 天气API (可选, 不配置则使用Mock数据)
# 和风天气: https://dev.qweather.com/ 注册获取免费API Key
# 免费版: 填写 32 位 API Key，如 abcdef1234567890abcdef1234567890
# 付费版: 填写 API Key + 自定义域名 (QWEATHER_BASE_URL)
QWEATHER_API_KEY=
# 付费版自定义域名 (可选)，如 mj76xaccx6.re.qweatherapi.com
QWEATHER_BASE_URL=

# ==================== 天气实时定位配置 ====================
# 是否启用天气页自动定位当前位置 (true/false)
WEATHER_LOCATION_ENABLED=true
# 定位失败或用户拒绝时使用的默认城市
WEATHER_DEFAULT_CITY=北京
# 浏览器定位超时时间 (毫秒)
WEATHER_LOCATION_TIMEOUT_MS=10000
# 浏览器定位是否使用高精度 (true 耗电更高但精度更好)
WEATHER_LOCATION_HIGH_ACCURACY=false

# Agent 运行时配置
COMPETITION_DEMO_ENABLED=false
AGENT_MAX_STEPS=5
AGENT_MAX_CONCURRENCY=2
RAG_MAX_CONCURRENCY=5
PERMISSION_MODE=normal
GUARDRAILS_BLOCK_HIGH_RISK_TOOLS=true
EXECUTOR_PARALLEL_ENABLED=true
EXECUTOR_MAX_ITERS=4
EXECUTOR_MAX_PARALLEL=6

# Web search: open_websearch / mock / ddgs
WEB_SEARCH_PROVIDER=open_websearch
OPEN_WEBSEARCH_BASE_URL=http://127.0.0.1:3210
OPEN_WEBSEARCH_ENGINE=bing
OPEN_WEBSEARCH_SEARCH_MODE=auto
OPEN_WEBSEARCH_TIMEOUT_SEC=15

# Local LLM fallback
LOCAL_LLM_ENABLED=false
LOCAL_LLM_FORCE=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=ollama

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ==================== 数据库配置 ====================
# true: 使用 SQLite (开发/测试), false: 使用 MySQL (生产)
USE_SQLITE=true

# SQLite 数据库 (农业数据专用)
SQLITE_DB_PATH=data/agro_agent.db

# MySQL 数据库配置 (USE_SQLITE=false 时生效)
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agro_agent_db
MYSQL_CHARSET=utf8mb4

# JWT 认证配置
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_DEFAULT_PASSWORD=admin123

# ==================== Video Generation ====================
VIDEO_GEN_API_KEY=
VIDEO_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_GEN_MODEL=seedance-2.0-lite
VIDEO_GEN_TIMEOUT=300
